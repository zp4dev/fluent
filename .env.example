# Copy to .env.local and fill in. Nothing here is a real secret.

# ── Lesson generation ────────────────────────────────────────────────────────
# Which service answers the request: ANTHROPIC (default) or OPEN_ROUTER.
# Both speak the Anthropic Messages API, so the key, model and base URL below
# are shared — PROVIDER only picks the host's conventions and defaults.
PROVIDER=ANTHROPIC

# The API key for whichever provider is selected above.
#   ANTHROPIC   -> sk-ant-...
#   OPEN_ROUTER -> sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults per provider:
#   ANTHROPIC   -> claude-sonnet-4-6
#   OPEN_ROUTER -> no default; you MUST set one, e.g. anthropic/claude-sonnet-4.5
ANTHROPIC_MODEL=

# Optional. Defaults per provider:
#   ANTHROPIC   -> https://api.anthropic.com
#   OPEN_ROUTER -> https://openrouter.ai/api
# NOTE: do not include a trailing /v1 — the SDK appends /v1/messages itself.
# Providers document their base WITH the /v1, so a pasted value would become
# /v1/v1/messages and 404 on an HTML page. A trailing /v1 is stripped and
# logged rather than left to fail confusingly.
ANTHROPIC_BASE_URL=

# ── Auth: emailed login codes ────────────────────────────────────────────────
# Signs the session cookie. Generate with: openssl rand -base64 32
# Unset => every session is refused. Changing it signs everyone out.
AUTH_SECRET=

# Resend, for delivering login codes: https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be an address on a domain verified in Resend, or codes land in spam.
EMAIL_FROM="Fluent <no-reply@learnfluent.app>"

# ── Storage ──────────────────────────────────────────────────────────────────
# Upstash Redis holds entitlements, orders, login codes and rate limits.
# Unset => rate limiting and login codes are disabled, and Pro cannot be granted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Transcripts ──────────────────────────────────────────────────────────────
# YouTube blocks cloud IPs, so hosted deployments need one of these.
SUPADATA_API_KEY=
TRANSCRIPT_PROXY_URL=

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated addresses allowed into /admin. Unset keeps the built-in
# pair (zp4dev@gmail.com, jackdvng@gmail.com). Anyone not listed is refused
# before a verification email is ever sent.
ADMIN_EMAILS=

# Shared secret for /api/admin/*. Unset => the curl path is refused; signing in
# at /admin with an allowlisted address still works.
ADMIN_SECRET=

# ── Bank details shown at checkout (public, inlined into the client) ─────────
NEXT_PUBLIC_BANK_NAME=Vietcombank
NEXT_PUBLIC_BANK_ID=970436
NEXT_PUBLIC_BANK_ACCOUNT=1039760814
NEXT_PUBLIC_BANK_HOLDER=DANG QUANG DANH
NEXT_PUBLIC_BANK_BRANCH=

# ── Misc ─────────────────────────────────────────────────────────────────────
# "on" shows the maintenance notice and blocks generation.
NEXT_PUBLIC_MAINTENANCE_MODE=off
# Grandfathered Lemon Squeezy license keys (legacy; no UI issues new ones).
LEMONSQUEEZY_API_KEY=
